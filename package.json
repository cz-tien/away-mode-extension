  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "22.19.15",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
